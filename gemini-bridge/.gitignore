# Live Google session cookies — never commit
.env

# Cached Code Assist OAuth access token
.codeassist-token.json
.codeassist-oauth.json
.codeassist-client.json

# Bridge-owned Chrome profile (contains a signed-in Google session)
.chrome-profile/

.venv/
__pycache__/
*.pyc

# Runtime artifacts
uploads/
*.log
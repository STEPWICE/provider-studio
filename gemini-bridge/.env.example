# Куки заполняются автоматически: запустите login.cmd и войдите в Google
# в открывшемся окне Chrome. Мост заберёт сессию сам и будет продлевать её.
# Значения ниже нужны только если вы задаёте сессию вручную.
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=

# Сетевые настройки моста
PORT=8010
HOST=127.0.0.1

# Прокси для обращений к Google. Без него Google помечает прямой IP и отвечает
# 429 на каждую инициализацию — выглядит точно как мёртвые куки, а на деле
# аккаунт съезжает на гостевой уровень: только flash-lite, без тарифа и квоты.
GEMINI_PROXY=http://127.0.0.1:10808

# Автовыбор лучшего выхода. Мост сам запускает отдельный Xray на штатном ядре
# v2rayN, проверяет узлы запросом к gemini.google.com и ведёт Google через тот,
# который реально отвечает 200. База и активный узел v2rayN не изменяются.
# V2RAYN_HOME — папка, где лежат guiConfigs\guiNDB.db и bin\xray\xray.exe.
# Если не указана, мост ищет установку сам.
# V2RAYN_HOME=C:\путь\к\v2rayN\app
# VPN_AUTOSWITCH=1
# VPN_POOL_SIZE=10
# VPN_PROBE_INTERVAL=1800
# VPN_PROBE_TIMEOUT=12
# VPN_PREFER_COUNTRIES=SE,FI,CH,FR,PL,DE,NL,GB,CA,US
# VPN_PROFILE_INDEX=

# Рассуждения модели в агентных ходах: 1 — видно (стоит ~1 с на раунд), 0 — быстрее.
# AGENT_THINKING=1

# Необязательно. Проверенный потолок промпта и порт отладки Chrome моста.
# MAX_PROMPT_CHARS=700000
# CDP_PORT=9223